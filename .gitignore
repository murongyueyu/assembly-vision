# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# ── 可再生的测试数据（跑 tools/make_synthetic.py 就能重建）──────
assembly_vision/data/synthetic/*
assembly_vision/data/synthetic_seq/*
assembly_vision/data/ui_preview/*
assembly_vision/data/probe/*
assembly_vision/data/refs/*

# ── 真实素材与标定产物（体积大 / 与具体硬件绑定，不入库）────────
assembly_vision/config/calibration.yaml
assembly_vision/data/videos/
*.mp4
*.avi
*.mov

# ── 运行时产物 ───────────────────────────────────────────────
_tmp_*
stereo_spliced.jpg
out.mp4

# ── 编辑器 / 系统 ────────────────────────────────────────────
# ★ 这里**不能写 `.vscode/`**（整目录忽略）—— git 的规则是"父目录被忽略时，
#   里面的 `!` 例外一律不生效"，那样 launch.json 就永远加不进来（实测踩过）。
#   ⇒ 改成"忽略目录里的内容、单独放行 launch.json"。
#   ★ launch.json 必须入库：它是"怎么跑这些工具"的唯一说明书，
#     里面钉了必须用的解释器（yolov11 环境）、integratedTerminal（OpenCV 窗口必须）
#     与 PYTHONIOENCODING=utf-8（防 GBK 假崩，实录 2.41）。
#     少了它，接手的人会用自己的解释器跑，然后遇到一堆"跑不起来"。
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ── 文档临时件（Word 打开 docx 时产生）──────────────────────
~$*.docx
~$*.xlsx

# ══════════════════════════════════════════════════════════════
# ★ 取反规则必须放在最后：.gitignore 是"后匹配者胜"，
#   放前面会被上面的通配规则覆盖（曾经踩过这个坑）。
#   作用：data 各子目录只保留占位文件，让目录结构进版本库。
# ══════════════════════════════════════════════════════════════
!assembly_vision/data/synthetic/.gitkeep
!assembly_vision/data/synthetic_seq/.gitkeep
!assembly_vision/data/ui_preview/.gitkeep
!assembly_vision/data/probe/.gitkeep
!assembly_vision/data/refs/.gitkeep
!assembly_vision/data/videos/.gitkeep

# ── data/refs 里**必须入库**的 8 张真机对账帧 ─────────────────────
# ★ 为什么破例：验收③④⑤以及一批诊断工具全都读这几张图 ——
#     verify_glove_fix / verify_allow_new / part_track_occlusion_test /
#     check_hand_box / measure_features_real / measure_holes_gap /
#     measure_holes_fix / measure_holes_ablation / measure_glove_area /
#     measure_glove_gamut / fix_glove_fragments
#   整目录忽略的话，**换一台电脑 clone 下来这些工具全部报错**（找不到图），
#   而这正是队友接手时最需要跑的东西。合计约 2.9MB。
# ★ 只放这 8 张；其余真机素材（refs 目录一共 15.5MB 的调试图、视频、
#   标定截图）继续忽略。
!assembly_vision/data/refs/assembly_choice.png
!assembly_vision/data/refs/assembly_left_check.png
!assembly_vision/data/refs/assembly_positions.png
!assembly_vision/data/refs/asm_raw.png
!assembly_vision/data/refs/glove_miss.png
!assembly_vision/data/refs/now_raw.png
!assembly_vision/data/refs/slot_check.png
!assembly_vision/data/refs/tray_empty.png

# ── 写配置时的备份（live_site_debug.py 按 w 会生成）──────────────
*.bak
