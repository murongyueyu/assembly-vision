diff --git a/tests/test_auto_length_gate.py b/tests/test_auto_length_gate.py
new file mode 100644
index 0000000..210485e
--- /dev/null
+++ b/tests/test_auto_length_gate.py
@@ -0,0 +1,28 @@
+"""静止2秒、不借旧帧、移动/遮挡撤销、每次放置仅触发一次。"""
+from assemvision.ui.auto_length_gate import PlacementGate
+
+
+def main():
+    config=dict(hold_seconds=2.,max_frame_gap_seconds=.5,min_frames=5,
+                max_center_drift_px=3.,max_length_drift_px=3.,rearm_empty_seconds=.6)
+    g=PlacementGate(config)
+    assert g.update(0.)['color']=='yellow'
+    for t in [0.,.4,.8,1.2,1.6]:
+        r=g.update(t,(10.,10.,100.))
+        assert r['color']=='green' and not r['trigger']
+    assert g.update(2.,(10.,10.,100.))['trigger']
+    assert not g.update(2.4,(10.,10.,100.))['trigger']
+    g.update(3.,empty=True)
+    assert g.update(3.7,empty=True)['color']=='yellow'
+    g.update(4.,(10.,10.,100.))
+    assert g.update(4.4)['color']=='yellow'  # 遮挡/出框撤销整个计时
+    assert g.update(4.8,(10.,10.,100.))['elapsed']==0.
+    g.update(5.2,(10.,10.,100.))
+    assert g.update(5.6,(20.,10.,100.))['elapsed']==0.  # 移动后从零开始
+    assert g.update(6.5,(20.,10.,100.))['elapsed']==0.  # 断帧不能累计
+    assert g.update(6.8,(float('nan'),10.,100.))['color']=='yellow'
+    print('test_auto_length_gate 全部通过')
+
+
+if __name__=='__main__':
+    main()
diff --git a/tests/test_zone_geometry.py b/tests/test_zone_geometry.py
new file mode 100644
index 0000000..adabcc5
--- /dev/null
+++ b/tests/test_zone_geometry.py
@@ -0,0 +1,62 @@
+"""毫米平面变换不使用工件真值拟合；蓝手套辅助不阻止完整金属候选。"""
+import copy
+from types import SimpleNamespace
+import cv2
+import numpy as np
+from assemvision.ui.zone_geometry import calibrated_measure,measurement_mask,endpoints_visible
+from tools.pi_diagnostics.auto_length_zone import candidate
+
+
+def main():
+    cal=dict(image_size=[320,240],intrinsics=dict(fx=100.,fy=100.,ppx=160.,ppy=120.),
+             floor_plane_normal=[0.,0.,1.],floor_plane_offset_calibrated_mm=100.,
+             axis_height_mm=0.,rectified_pixels_per_mm=4.,distortion_coefficients=[0.]*5,
+             calibration_scope='synthetic',validation_truth_length_mm=64.3,
+             axis_band_half_width_mm=1.5,shaft_fit_fraction=[.35,.85],min_axis_pixels=5)
+    values=[]
+    for x,y in [(30,40),(190,150)]:
+        mask=np.zeros((240,320),np.uint8);mask[y:y+15,x:x+64]=255
+        a,_=calibrated_measure(mask,(x-10,y-10,90,40),cal)
+        assert a['ok'] and abs(a['length_mm']-64.)<.6
+        other=copy.deepcopy(cal);other['validation_truth_length_mm']=999.
+        b,_=calibrated_measure(mask,(x-10,y-10,90,40),other)
+        assert a['length_mm']==b['length_mm']
+        values.append(a['length_mm'])
+    assert abs(values[0]-values[1])<.6
+    bad=copy.deepcopy(cal);bad['distortion_coefficients'][0]=.1
+    try:calibrated_measure(mask,(180,140,90,40),bad)
+    except ValueError:pass
+    else:raise AssertionError('不能静默忽略非零畸变')
+    settings=dict(zone=[10,10,180,100],green_hsv_lower=[35,40,0],green_hsv_upper=[95,255,255],
+                  glove_hsv_lower=[91,60,0],glove_hsv_upper=[140,255,255],min_seed_pixels=20,
+                  min_contour_area_px=60.,edge_margin_px=8,min_aspect=1.15,max_aspect=5.,
+                  max_glove_pixels=10,allow_glove_support=True)
+    image=np.full((130,220,3),(40,140,40),np.uint8)
+    seed=np.zeros((130,220),np.uint8)
+    image[45:60,40:150]=(90,160,190);image[30:90,145:158]=(100,180,200)
+    seed[45:60,40:150]=255;seed[30:90,145:158]=255
+    image[80:100,60:100]=(220,80,30)
+    glove=np.zeros_like(seed);glove[80:100,60:100]=255
+    seg=SimpleNamespace(brass_mask=seed,metal_mask=seed,glove_mask=glove)
+    mask=measurement_mask(image,seg,settings)
+    assert not mask[90,70] and mask[50,100]
+    metrics,_,_=candidate(seg,settings['zone'],settings,mask)
+    assert metrics is not None
+    settings.update(endpoint_fit_fraction=[.35,.85],endpoint_axis_band_px=4,
+                    endpoint_margin_px=6,max_endpoint_glove_pixels=3)
+    assert endpoints_visible(image,mask,settings['zone'],settings)
+    occluded=image.copy();occluded[47:57,155:170]=(220,80,30)
+    shortened=measurement_mask(occluded,seg,settings)
+    assert endpoints_visible(occluded,shortened,settings['zone'],settings)  # 邻近手套不能当作遮挡
+    assert not endpoints_visible(image,np.zeros_like(mask),settings['zone'],settings)
+    edge=np.zeros_like(mask);edge[50:66,13:81]=255
+    settings['edge_margin_px']=3
+    assert candidate(seg,settings['zone'],settings,edge)[0] is not None
+    edge=np.zeros_like(mask);edge[50:66,12:80]=255
+    assert candidate(seg,settings['zone'],settings,edge)[0] is None
+    settings['allow_glove_support']=False
+    assert candidate(seg,settings['zone'],settings,mask)[0] is None
+    print('test_zone_geometry 全部通过')
+
+
+if __name__=='__main__':main()
diff --git a/tools/pi_diagnostics/auto_length_zone.py b/tools/pi_diagnostics/auto_length_zone.py
new file mode 100644
index 0000000..8d2df4e
--- /dev/null
+++ b/tools/pi_diagnostics/auto_length_zone.py
@@ -0,0 +1,169 @@
+"""独立自动检测框联调：黄框等待，完整候选稳定2秒后自动参考测量。
+
+★ 不证明三维平放，不判尺寸合格，不推进六步。独立标定完成后再接生产流程。
+"""
+from pathlib import Path
+import argparse
+import json
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+import cv2
+import numpy as np
+from assemvision.config import load_config
+from assemvision.core.segment import Segmenter
+from assemvision.core.length import measure_length
+from assemvision.sources.factory import make_source
+from assemvision.imgio import imwrite_safe
+from assemvision.ui.auto_length_gate import PlacementGate
+from assemvision.ui.zone_geometry import measurement_mask, calibrated_measure, endpoints_visible
+from assemvision.ui.opencv_renderer import _Text
+from assemvision.ui.base import find_cjk_font
+
+
+def candidate(seg, zone, settings, mask=None):
+    x,y,w,h=zone
+    if mask is None:mask=seg.brass_mask if seg.brass_mask is not None else seg.metal_mask
+    if mask is None:
+        return None, '没有有效金属掩膜', False
+    sub=mask[y:y+h,x:x+w]
+    contours,_=cv2.findContours(sub,cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_NONE)
+    contours=[c for c in contours if cv2.contourArea(c)>=settings['min_contour_area_px']]
+    if not contours:
+        return None,'请将底座和立柱成品平放入框',True
+    if not settings.get('allow_glove_support',False) and seg.glove_mask is not None and np.count_nonzero(seg.glove_mask[y:y+h,x:x+w])>settings['max_glove_pixels']:
+        return None,'请将手移出检测框',False
+    if len(contours)!=1:
+        return None,'请只放一个组件，等待完整轮廓',False
+    c=contours[0]
+    bx,by,bw,bh=cv2.boundingRect(c)
+    margin=settings['edge_margin_px']
+    if min(bx,by,w-bx-bw,h-by-bh)<margin:
+        return None,'请将组件完整移入框内，避开边缘',False
+    (cx,cy),(rw,rh),angle=cv2.minAreaRect(c)
+    ratio=max(rw,rh)/max(1.,min(rw,rh))
+    if not settings['min_aspect']<=ratio<=settings['max_aspect']:
+        return None,'请按示意平放底座和立柱组件',False
+    return (cx+x,cy+y,max(rw,rh)+1.),'轮廓完整，保持静止',False
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config',default='config/auto_length_zone_preview.yaml')
+    parser.add_argument('--windowed',action='store_true')
+    args=parser.parse_args()
+    settings=load_config(str(ROOT/args.config)).data
+    zone=tuple(int(v) for v in settings['zone'])
+    calibration=json.loads((ROOT/'config'/settings['calibration_file']).read_text(encoding='utf-8'))
+    gate=PlacementGate(settings)
+    camera=load_config(str(ROOT/'config/camera.yaml'))
+    camera.set('depth.enabled',False)
+    source=make_source(camera)
+    segmenter=Segmenter(load_config(str(ROOT/'config/workpiece.yaml')))
+    import app
+    W,H=app._detect_screen()
+    text=_Text(find_cjk_font(),1.)
+    cv2.setNumThreads(1)
+    output=ROOT/'data/probe'/time.strftime('f_auto_length_zone_%Y%m%d_%H%M%S')
+    output.mkdir(parents=True,exist_ok=False)
+    (output/'settings.json').write_text(json.dumps(settings,indent=2,ensure_ascii=False),encoding='utf-8')
+    window='Automatic Length Zone - PREVIEW'
+    measured=None;number=0;previous_measured=False;last_image=None
+    try:
+        source.open()
+        cv2.namedWindow(window,cv2.WINDOW_NORMAL)
+        cv2.setWindowProperty(window,cv2.WND_PROP_FULLSCREEN,
+                              cv2.WINDOW_NORMAL if args.windowed else cv2.WINDOW_FULLSCREEN)
+        if args.windowed:cv2.resizeWindow(window,min(W,1280),min(H-60,720))
+        while True:
+            tick=time.monotonic()
+            frame=source.read(want_full=False)
+            if frame is None:
+                gate.update(time.monotonic())
+                print('取帧失败；稳定计时撤销',flush=True)
+                if cv2.waitKey(1)&255 in (ord('q'),27):break
+                continue
+            image=frame.left
+            fh,fw=image.shape[:2]
+            x,y,w,h=zone
+            if x<0 or y<0 or x+w>fw or y+h>fh:
+                raise ValueError('配置检测框超出D435原始画面')
+            seg=segmenter.segment(image,ts=frame.ts,scale=1.,want_features=False,
+                                  work_roi=None,mm_per_px=settings['reference_mm_per_px'])
+            local_mask=measurement_mask(image,seg,settings)
+            metrics,reason,empty=candidate(seg,zone,settings,mask=local_mask)
+            if metrics is not None and not endpoints_visible(image,local_mask,zone,settings):
+                metrics=None
+                reason='手可扶，请露出底座外侧面和螺纹尖端'
+            status=gate.update(time.monotonic(),metrics,empty)
+            if previous_measured and not status['measured']:measured=None
+            if status['trigger']:
+                measured,rectified=calibrated_measure(local_mask,zone,calibration)
+                measured['old_fixed_scale_length_mm']=measure_length(local_mask,zone,settings['reference_mm_per_px']).get('length_mm')
+                measured.update(frame_index=frame.index,zone=zone,scope='检测框联调参考值；未验证毫米精度；不作质量放行',
+                                source_scale_mm_per_px=settings['reference_mm_per_px'])
+                number+=1
+                name='placement_%02d'%number
+                imwrite_safe(str(output/(name+'.raw.png')),image)
+                imwrite_safe(str(output/(name+'.mask.png')),local_mask)
+                imwrite_safe(str(output/(name+'.rectified.png')),rectified)
+                (output/(name+'.json')).write_text(json.dumps(measured,ensure_ascii=False,indent=2),encoding='utf-8')
+                print('AUTO_MEASURE',json.dumps(measured,ensure_ascii=False),flush=True)
+            previous_measured=status['measured']
+            canvas=np.full((H,W,3),(23,19,14),np.uint8)
+            scale=min(W*.70/fw,(H-100)/fh)
+            nw,nh=round(fw*scale),round(fh*scale)
+            ox,oy=24,round((H-nh)/2)
+            canvas[oy:oy+nh,ox:ox+nw]=cv2.resize(image,(nw,nh),interpolation=cv2.INTER_LINEAR)
+            green=(154,218,65);amber=(81,196,248);white=(244,240,232);grey=(173,160,141)
+            color=green if status['color']=='green' else amber
+            a=(round(x*scale+ox),round(y*scale+oy));b=(round((x+w)*scale+ox),round((y+h)*scale+oy))
+            cv2.rectangle(canvas,a,b,color,3,cv2.LINE_AA)
+            mid=(a[1]+b[1])//2
+            for px in range(a[0]+12,b[0]-12,20):
+                cv2.line(canvas,(px,mid),(min(px+10,b[0]-12),mid),color,1)
+            fs=max(18,round(H/600*20));items=[]
+            def line(value,xx,yy,size=20,col=white):
+                items.append((value,(int(xx),int(yy)),col,max(18,round(size*H/600)),'la'))
+            line('自动长度检测 · 校准联调',24,15,24)
+            line('检测区：平放完整组件',a[0],max(60,a[1]-fs-12),20,color)
+            rx=round(W*.73)
+            line('黄框等待 / 绿框计时',rx,H*.16,23,color)
+            for i,row in enumerate((reason[:13],reason[13:])):
+                if row:line(row,rx,H*(.24+i*.045),20)
+            if status['measured'] and measured:
+                line('自动测量已完成',rx,H*.39,24,green)
+                value=measured.get('length_mm')
+                line(('%.2f mm'%value) if value is not None else '测量无效',rx,H*.48,34,amber)
+                line('校准未验收，仅参考',rx,H*.60,19,amber)
+                line('移出组件后可再测',rx,H*.67,19,grey)
+            else:
+                elapsed=min(settings['hold_seconds'],status['elapsed'])
+                line('稳定 %.1f / %.1f 秒'%(elapsed,settings['hold_seconds']),rx,H*.43,25,color)
+                line('连续绿框2秒自动测量',rx,H*.54,20,grey)
+            line('手可辅助扶平；勿垫高底座或遮住端点',24,H-48,20,amber)
+            line('R 重测   Q 退出',rx,H-48,20,grey)
+            text.draw(canvas,items)
+            if status['trigger']:
+                imwrite_safe(str(output/('placement_%02d.ui.png'%number)),canvas)
+            if last_image is None:
+                imwrite_safe(str(output/'initial.ui.png'),canvas)
+                print('ZONE_READY',output,zone,flush=True)
+            last_image=canvas
+            cv2.imshow(window,canvas)
+            key=cv2.waitKey(1)&255
+            if key in (ord('q'),27):break
+            if key==ord('r'):gate.reset();measured=None;previous_measured=False
+            delay=max(0.,1./settings['render_fps']-(time.monotonic()-tick))
+            if delay:time.sleep(delay)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        source.close()
+        cv2.destroyAllWindows()
+
+
+if __name__=='__main__':
+    main()
