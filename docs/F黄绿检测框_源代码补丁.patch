+"""F检测框联调：只负责稳定两秒触发，不改变长度算法或质量门槛。"""
+import math
+
+
+class PlacementGate:
+    def __init__(self, settings):
+        self.settings = settings
+        self.hold = float(settings['hold_seconds'])
+        self.gap = float(settings['max_frame_gap_seconds'])
+        self.min_frames = int(settings['min_frames'])
+        if not all(math.isfinite(v) and v > 0 for v in (self.hold, self.gap)) or self.min_frames < 2:
+            raise ValueError('稳定计时参数无效')
+        self.reset()
+
+    def reset(self):
+        self.start = self.last = self.anchor = None
+        self.frames = 0
+        self.triggered = False
+        self.empty_since = None
+
+    def update(self, now, metrics=None, empty=False):
+        if self.triggered:
+            if empty:
+                if self.empty_since is None:
+                    self.empty_since = now
+                if now-self.empty_since >= float(self.settings['rearm_empty_seconds']):
+                    self.reset()
+            else:
+                self.empty_since = None
+            if self.triggered:
+                return dict(color='green', elapsed=self.hold, trigger=False, measured=True)
+        if metrics is None:
+            self.start = self.anchor = self.last = None
+            self.frames = 0
+            return dict(color='yellow', elapsed=0., trigger=False, measured=False)
+        metrics = tuple(float(v) for v in metrics)
+        valid = all(math.isfinite(v) for v in metrics)
+        if not valid:
+            return self.update(now, None)
+        limits = (float(self.settings['max_center_drift_px']),)*2 + (
+            float(self.settings['max_length_drift_px']),)
+        stable = (self.anchor is not None and self.last is not None and 0 < now-self.last <= self.gap
+                  and all(abs(a-b) <= limit for a,b,limit in zip(metrics,self.anchor,limits)))
+        if not stable:
+            self.start, self.anchor, self.frames = now, metrics, 0
+        self.last = now
+        self.frames += 1
+        elapsed = max(0.,now-self.start)
+        fire = elapsed >= self.hold and self.frames >= self.min_frames
+        if fire:
+            self.triggered = True
+        return dict(color='green',elapsed=elapsed,trigger=fire,measured=self.triggered)
