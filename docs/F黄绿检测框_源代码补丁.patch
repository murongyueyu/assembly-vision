            "test_process_integration", "test_wheel_holes", "test_prestart_candidate",
            "test_identity_size_candidate", "test_process_candidate", "test_process_tracking",
            "test_abcde_integration", "test_pi_deployment",
-           "test_glove_multi", "test_height_stages", "test_ui_six_step"]
+           "test_glove_multi", "test_height_stages", "test_ui_six_step", "test_auto_length_gate", "test_zone_geometry"]
 # ★ 三个追踪相关模块的分工（2026-10）：
 #     `test_tracker`       —— core 的**单元**覆盖（遮挡三档 / 身份余量 / 形状冻结 /
