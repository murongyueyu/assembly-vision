    {
      "name": "⑥ 零件检测实时演示（轮廓 + 追踪 + 遮挡）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\assembly_vision\\tools\\part_track_demo.py",
      "cwd": "${workspaceFolder}\\assembly_vision",
      "python": "D:\\miniconda\\envs\\yolov11\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "⑦ 离线回归（16 个模块，不需要相机）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\assembly_vision\\tests\\run_all.py",
      "cwd": "${workspaceFolder}\\assembly_vision",
      "python": "D:\\miniconda\\envs\\yolov11\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONIOENCODING": "utf-8"
