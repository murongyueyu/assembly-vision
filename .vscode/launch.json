      "cwd": "${workspaceFolder}\\assembly_vision",
      "python": "D:\\miniconda\\envs\\yolov11\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "⑤ 实时预览（ROI + 分割 + 覆盖率 + 识别 + 过曝报警）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\assembly_vision\\tools\\preview.py",
      "cwd": "${workspaceFolder}\\assembly_vision",
      "python": "D:\\miniconda\\envs\\yolov11\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
