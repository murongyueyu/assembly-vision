      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\ai_测试工具\\sweep_camera_controls.py",
      "cwd": "${workspaceFolder}\\ai_测试工具",
      "python": "D:\\miniconda\\envs\\yolov11\\python.exe",
      "console": "integratedTerminal",
